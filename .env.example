# Database used by src/data.
#
# Production (Vercel): Turso. Both variables are required on Vercel, where a local
# SQLite file would be lost on every redeploy.
# TURSO_DATABASE_URL=libsql://<database>-<organization>.turso.io
# TURSO_AUTH_TOKEN=<token from `turso db tokens create <database>`>
#
# Local: without the Turso variables, a SQLite file is used (file:pipeline.db by default).
# DATABASE_URL=file:pipeline.db
